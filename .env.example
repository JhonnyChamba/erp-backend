PORT=3000
FRONTEND_URL=http://localhost:5173
# Opción 1: Variables individuales (Local o Supabase Pooler)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password
DATABASE_NAME=db_deskounta
DATABASE_SSL=false
# Opción 2: Cadena de conexión directa de Supabase (Transaction/Session Pooler IPv4)
# DATABASE_URL=postgresql://postgres.tnbfcixqgrspmgqrgnag:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_SYNCHRONIZE=false
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=15h